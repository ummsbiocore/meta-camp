#!/usr/bin/env python3

import argparse
import os
from os import makedirs, symlink, remove
from os.path import abspath, basename, exists, join, getsize, isdir

def main(args):
    r = args.row['closest_genome_reference']
    r_path = 'None'
    if str(r) != 'nan':
        parts = r.split('_')
        r_path = join(args.gtdb_db, 'skani/database', parts[0], parts[1][0:3], parts[1][3:6], parts[1][6:9], r + '_genomic.fna.gz')
    with open(join(args.out_dir, str(args.row['user_genome']) + '.ref'), 'w') as f_out:
        f_out.write(r_path + '\n')

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("row", help="De novo gene annotations in a single sample")
    parser.add_argument("out_dir", help="Output directory")    
    parser.add_argument("gtdb_db", help="gtdb")
    args = parser.parse_args()
    main(args)